# Stage 1: Model Training
FROM python:3.9-slim AS model_training

# Set working directory
WORKDIR /app

# create virtual environment
RUN python -m venv /app/venv

# upgrade pip inside the environment
RUN /app/venv/bin/pip install --upgrade pip

# install dependencies inside the environment
COPY requirements.txt /app/
RUN /app/venv/bin/pip install -r requirements.txt

# Copy training scripts and requirements
COPY src/model_training.py /app/

# Install system dependencies for TensorFlow and image handling
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    wget \
    git \
    libgl1 \
    libsm6 \
    libxext6 \
    libxrender-dev && \
    rm -rf /var/lib/apt/lists/*

# Install Python packages
RUN pip install --upgrade pip
RUN pip install --no-cache-dir -r requirements.txt

# Run training script (produces my_model.keras, saved_model, metrics.json, etc.)
RUN python model_training.py --epochs 10 --batch_size 64

# Stage 2: Serving
FROM python:3.9-slim AS serving

WORKDIR /app

# Copy trained model artifacts from training stage
COPY --from=model_training /app/my_model.keras /app/
COPY --from=model_training /app/saved_model /app/saved_model
COPY --from=model_training /app/metrics.json /app/
COPY --from=model_training /app/training.log /app/

# Copy serving code and templates/statics
COPY src/main.py /app/
COPY src/templates /app/templates
COPY src/statics /app/statics

# Install only runtime requirements (lighter image)
COPY requirements.txt /app/
RUN pip install --no-cache-dir --trusted-host pypi.python.org -r requirements.txt

# Expose Flask API port
EXPOSE 4000

# Optional environment variables
ENV FLASK_ENV=production
ENV FLASK_APP=main.py

# Enable GPU support if using tensorflow-gpu (optional)
# ENV TF_FORCE_GPU_ALLOW_GROWTH=true

# Health check endpoint to monitor container
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
  CMD curl --fail http://localhost:4000/ || exit 1

# Start Flask server with production-ready WSGI
# Using Gunicorn for better concurrency and performance
RUN pip install gunicorn
CMD ["gunicorn", "--bind", "0.0.0.0:4000", "--workers", "4", "main:app"]
